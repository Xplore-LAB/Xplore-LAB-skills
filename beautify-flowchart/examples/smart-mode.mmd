%% smart模式示例：智能分析后，针对性优化
%% 发现布局尚可，样式需要优化，所以主要美化样式
flowchart TD
    Start([开始]):::startEnd --> Input[/输入数据/]:::io
    Input --> Process1[数据验证]:::process
    Process1 --> Check{数据有效?}:::decision

    Check -->|有效| Process2[数据处理]:::process
    Check -->|无效| Error[错误处理]:::error
    Error --> Input

    Process2 --> Process3[保存结果]:::process
    Process3 --> Success[操作成功]:::success
    Success --> End([结束]):::startEnd

    %% 应用专业配色，提升视觉效果
    classDef startEnd fill:#10b981,stroke:#059669,stroke-width:3px,color:#fff,font-weight:bold,font-size:16px
    classDef process fill:#3b82f6,stroke:#2563eb,stroke-width:2px,color:#fff,font-weight:bold
    classDef decision fill:#f59e0b,stroke:#d97706,stroke-width:2px,color:#fff,font-weight:bold
    classDef io fill:#8b5cf6,stroke:#7c3aed,stroke-width:2px,color:#fff,font-weight:bold
    classDef error fill:#ef4444,stroke:#dc2626,stroke-width:2px,color:#fff,font-weight:bold
    classDef success fill:#06b6d4,stroke:#0891b2,stroke-width:3px,color:#fff,font-weight:bold,font-size:16px

    %% 添加阴影效果
    linkStyle default stroke:#64748b,stroke-width:2px,fill:none
