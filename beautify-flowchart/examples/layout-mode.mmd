%% layout模式示例：优化布局结构，保持简单样式
%% 使用分组和清晰的层次
flowchart TD
    subgraph 认证模块 ["🔐 用户认证"]
        A[开始] --> B[输入用户名]
        B --> C{用户名有效?}
        C -->|否| B
        C -->|是| D[输入密码]
        D --> E{密码正确?}
    end

    subgraph 结果处理 ["✅ 结果处理"]
        E -->|是| F[登录成功]
        E -->|否| G[显示错误]
        G --> D
        F --> H[进入主页]
    end

    subgraph 结束模块 ["🔚 结束"]
        H --> I[结束]
    end

    %% 简单样式，主要优化布局
    style A fill:#e8eaf6,stroke:#3f51b5,stroke-width:2px
    style B fill:#e8eaf6,stroke:#3f51b5,stroke-width:2px
    style C fill:#fff3e0,stroke:#ff9800,stroke-width:2px
    style D fill:#e8eaf6,stroke:#3f51b5,stroke-width:2px
    style E fill:#fff3e0,stroke:#ff9800,stroke-width:2px
    style F fill:#e8f5e9,stroke:#4caf50,stroke-width:2px
    style G fill:#ffebee,stroke:#f44336,stroke-width:2px
    style H fill:#e8eaf6,stroke:#3f51b5,stroke-width:2px
    style I fill:#e8eaf6,stroke:#3f51b5,stroke-width:2px

    %% 子图样式
    style 认证模块 fill:#f5f5f5,stroke:#9e9e9e,stroke-width:1px
    style 结果处理 fill:#f5f5f5,stroke:#9e9e9e,stroke-width:1px
    style 结束模块 fill:#f5f5f5,stroke:#9e9e9e,stroke-width:1px
